rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seluruh data GaneMaX.Ai diakses lewat API server (/api/*), bukan langsung
    // dari browser. Satu aturan ini menggantikan daftar panjang per koleksi —
    // izinnya sama persis, dan koleksi baru (banner, push, dll) otomatis ikut
    // tanpa perlu publish rules lagi tiap ada fitur baru.
    match /{collection}/{docId} {
      allow read: if true;
      allow write: if docId is string && docId.size() > 0 && docId.size() <= 128;
    }
  }
}
