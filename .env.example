# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Authentication secret for signing HMAC session tokens
AUTH_SECRET=

# Secret for migration and maintenance
MIGRATION_SECRET=

# AI Provider API Keys (proxy-safeguarded on server-side)
GANEMAX_AI_API_KEY=


# --- Push notification (pengingat sesi T-5 menit) ---
# Buat sepasang kunci sekali saja:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ganemaxbot.my.id
# Rahasia untuk endpoint cron POST /api/push/dispatch (header: x-cron-secret)
PUSH_CRON_SECRET=

# --- Paket proxy (v21) ---
# Kunci API dari dashboard Webshare (Proxy → API). Hanya disimpan di server.
WEBSHARE_API_KEY=""
# direct (default) atau backbone
WEBSHARE_MODE="direct"
# Opsional: batasi negara proxy, mis. ID
WEBSHARE_COUNTRY=""
# Opsional: plan Webshare tertentu
WEBSHARE_PLAN_ID=""
# Isi paket (default 5 proxy, Rp100.000, 30 hari)
PROXY_PACKAGE_QTY="5"
PROXY_PACKAGE_PRICE="100000"
PROXY_PACKAGE_DAYS="30"

# --- v22 ---
# (tidak ada variabel baru; WEBSHARE_API_KEY di atas juga dipakai untuk
#  mengambil foto produk lewat proxy saat Shopee menolak IP server)
